#include <windows.h>
1 RT_MANIFEST "launcher.manifest"
// a gold T on JGdaCaesar's red, drawn for the Mod Manager (icon_pick/make_ico.py); no outside art, no credit needed
1 ICON "launcher.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "JGdaCaesar"
      VALUE "FileDescription", "Total War Mod Manager: mods, presets and Play for 32-bit and 64-bit Total War: ATTILA"
      VALUE "FileVersion", "1.0"
      VALUE "ProductName", "Total War Mod Manager"
      VALUE "ProductVersion", "1.0"
      VALUE "OriginalFilename", "TotalWarModManager.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
